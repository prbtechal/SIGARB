# SIGARB — /var/www/app/sigarb/shared/.env (MODELO). Dono root:sigarb, permissão 640. Segredos NOVOS gerados na VM.
APP_NAME=SIGARB
APP_ENV=production
APP_DEBUG=false
APP_KEY=                      # gerar: php8.5 -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
APP_URL=https://sigarb.prb.intra
LOG_CHANNEL=sigarb_json
LOG_LEVEL=info
DB_CONNECTION=mysql
DB_HOST=192.168.200.9
DB_PORT=3306
DB_DATABASE=sigarb
DB_USERNAME=sigarb_app
DB_PASSWORD=                  # definido pelo DBA
SESSION_DRIVER=database
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
SIGARB_SAUDE_CACHE=file
SIGARB_DOCUMENTOS_ROOT=/var/www/app/sigarb/shared/storage/app/private
SIGARB_DISCO_MINIMO_BYTES=536870912
# Regras PROVISÓRIAS (não institucionais). Vazio = todas bloqueadas (padrão da release). Ligar só com autorização
# registrada, listando as operações: SAIDA,BAIXA,TRANSFERENCIA,RESERVA,MANUTENCAO,ENTREGA,DEVOLUCAO,ACAUTELAMENTO,INSPECAO,DESACAUTELAMENTO,INVENTARIO
SIGARB_OPERACOES_PROVISORIAS=
# Prazos provisórios de alertas e inspeção (dias).
SIGARB_ALERTA_VALIDADE_DIAS=90
SIGARB_INSPECAO_DIAS=365
SIGARB_ALERTA_INSPECAO_DIAS=30
# shared/migr.env (600 root, existe SÓ na janela de migração): DB_USERNAME=sigarb_migr / DB_PASSWORD=...
